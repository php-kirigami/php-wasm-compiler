FROM kirigami-php-wasm:base

ARG JSPI
ARG FREETDS_VERSION

RUN set -euxo pipefail && \
    source /root/emsdk/emsdk_env.sh && \
    wget https://www.freetds.org/files/stable/freetds-$FREETDS_VERSION.tar.gz && \
    tar xf freetds-$FREETDS_VERSION.tar.gz

WORKDIR /root/freetds-$FREETDS_VERSION

# db-lib (libsybdb) only -- what ext/pdo_dblib links. Kept dependency-free
# for a first pass: --disable-odbc (FreeTDS's own ODBC driver, not needed
# here), --disable-apps/--disable-server/--disable-pool (tsql & co, a TDS
# server, a connection pooler), no TLS (--without-openssl/--without-gnutls,
# so encrypted connections -- which Azure SQL requires -- aren't possible
# yet), no Kerberos. --disable-libiconv: charset conversion (UCS-2LE <->
# client charset, needed for TDS 7+) goes through musl's own iconv, which
# the core already exports to side modules (iconv_open/iconv/iconv_close).
# --disable-threadsafe: single-threaded WASM VM. --disable-mars: MARS
# (several active result sets on one connection, used by FreeTDS's own ODBC
# driver, not db-lib) needs thread condition variables -- with
# --disable-threadsafe, src/tds/packet.c's MARS code fails to compile
# ("use of undeclared identifier 'FreeTDS_Condition_not_compiled'", the
# deliberate compile error include/freetds/thread.h plants for that case).
RUN source /root/emsdk/emsdk_env.sh && \
    emconfigure ./configure \
        --build i386-pc-linux-gnu \
        --host wasm32-unknown-emscripten \
        --prefix=/root/install \
        --sysconfdir=/etc \
        --disable-shared \
        --enable-static \
        --disable-odbc \
        --disable-apps \
        --disable-server \
        --disable-pool \
        --disable-libiconv \
        --disable-threadsafe \
        --disable-mars \
        --without-openssl \
        --without-gnutls

# Build each library directory by name, in src/Makefile.am's SUBDIRS order
# (utils/replacements/tds are convenience libraries libsybdb links in),
# and libsybdb.la itself by explicit target -- not src/dblib's default
# "all", which also descends into its unittests/ directory.
RUN source /root/emsdk/emsdk_env.sh && \
    export JSPI_FLAGS=$(if [ "$JSPI" = "1" ]; then echo "-sSUPPORT_LONGJMP=wasm -fwasm-exceptions"; else echo ""; fi) && \
    EMCC_FLAGS=" -sSIDE_MODULE $JSPI_FLAGS" emmake make -C include && \
    for dir in src/utils src/replacements src/tds; do \
        EMCC_FLAGS=" -sSIDE_MODULE $JSPI_FLAGS" emmake make -C $dir || exit 1; \
    done && \
    EMCC_FLAGS=" -sSIDE_MODULE $JSPI_FLAGS" emmake make -C src/dblib libsybdb.la

# ext/pdo_dblib's config.m4 checks for $DIR/include/sybdb.h and
# $DIR/lib/libsybdb.a directly (no pkg-config), so install just those:
# libsybdb.a via libtool (it already embeds the tds/replacements/utils
# convenience-library objects) and the public db-lib headers by hand,
# including tds_sysdep_public.h (generated by configure, #included by
# sybdb.h).
RUN source /root/emsdk/emsdk_env.sh && \
    mkdir -p /root/install/lib /root/install/include && \
    cp src/dblib/.libs/libsybdb.a /root/install/lib/ && \
    cp include/sybdb.h include/sybfront.h include/syberror.h include/tds_sysdep_public.h /root/install/include/
