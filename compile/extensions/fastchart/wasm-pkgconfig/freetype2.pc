# Local shim (not upstream): see ../PROVENANCE.md. Points pkg-config at the
# vendorLib staging path; Libs repeats the archive vendorLibs already links.
Name: freetype2
Description: freetype2 as staged for the fastchart side-module build
Version: 26.6.20
Cflags: -I/build/vendor/libfreetype/include/freetype2
Libs: /build/vendor/libfreetype/lib/libfreetype.a
