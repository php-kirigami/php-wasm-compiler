# Local shim (not upstream): see ../PROVENANCE.md. Points pkg-config at the
# vendorLib staging path; Libs repeats the archive vendorLibs already links.
Name: libwebp
Description: libwebp as staged for the fastchart side-module build
Version: 1.6.0
Cflags: -I/build/vendor/libwebp/include
Libs: /build/vendor/libwebp/lib/libwebp.a /build/vendor/libwebp/lib/libsharpyuv.a
