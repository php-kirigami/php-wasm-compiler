# Dependencies
node_modules/

# Build outputs
/node-builds/
/web-builds/
/output/

# Assembled npm packages for mode:shared extensions (@kirigami/phpext-<name>,
# npm workspace under packages/*, see CLAUDE.md decision 38). package.json,
# index.js, and .buildhash ARE committed — they're mechanically maintained by
# `compile/cli.mjs compile-extension` (patch version bumps only when the
# build output's hash actually changes) rather than hand-edited, but they're
# the real source of truth for what's published, not throwaway output.
# Only the compiled artifacts themselves are regenerated and ignored:
packages/*/manifest.json
packages/*/manifest-*.json
packages/*/*.so

# Packed tarballs produced by scripts/publish.js before `npm publish`.
/packs/

# Vendored dependency builds staged into a shared extension's own source
# directory by `compile/cli.mjs compile-extension` (config.yaml's `vendorLib`
# field) — copied fresh from compile/<lib>/jspi/dist/ on every run.
compile/extensions/*/vendor/

# Compiled third-party libraries (rebuilt via `make`, not committed — see
# CLAUDE.md decision on not vendoring prebuilt binaries)
compile/*/asyncify/
compile/*/jspi/
compile/base-image/.ready

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
